# Copy to .env.production and replace host-specific values.
INFDRAWING_VERSION=local
PUBLIC_BASE_URL=https://draw.example.com
CORS_ORIGINS=["https://draw.example.com"]
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=infdrawing
POSTGRES_USER=infdrawing
MINIO_BUCKET=infdrawing
MINIO_ROOT_USER=infdrawing
GRAFANA_ADMIN_USER=admin

# The default production provider uses HTTPS. For a private provider, set its
# HTTPS base URL and exact hostname allowlist; store the key in deploy/secrets.
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
PROVIDER_ALLOWED_HOSTS=["api.openai.com"]

# External ComfyUI is the default. On Linux, add an extra_hosts mapping if the
# service runs on the Docker host. On Docker Desktop this hostname is built in.
COMFYUI_BASE_URL=http://host.docker.internal:8188

# The managed-comfyui profile is opt-in. Build and audit this image yourself;
# the repository intentionally ships no model-bearing image.
COMFYUI_IMAGE=infdrawing/comfyui-unconfigured:local
COMFYUI_MODELS_DIR=./deploy/models
NVIDIA_VISIBLE_DEVICES=all
